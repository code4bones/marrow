# Copy this file to .env and fill in real values. Never commit .env itself.

# Режим работы
MODE=both # gateway | client | both

# Client specific
MCP_CLIENT_AUTH=changeme
GW_ENDPOINT=https://example.invalid/api

# Gateway specific
PORT=7000
BIND=0.0.0.0
API_ENDPOINT=/api
MCP_TOKEN=changeme

# DB
# IMPORTANT: this must be a database dedicated to local dev/smoke-test use,
# never the same host+database a real deployment's own .env points at. Every
# smoke script creates and deletes real rows (users, projects, tokens) on
# every run -- if POSTGRES_HOST/POSTGRES_DB here ever end up matching a live
# deployment's own values (even by reaching the same server over a
# different hostname/IP), smoke runs silently pollute production. This
# actually happened once (T-MEMORY-053's item 5) -- POSTGRES_HOST pointed at
# a deploy host's LAN IP with POSTGRES_DB set to the exact name that host's
# own prod .env also used, and they turned out to be the identical database.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=project_memory
POSTGRES_USER=project_memory
POSTGRES_PASSWORD=changeme
POSTGRES_SSL=false

ARTIFACT_DIR=./artifacts

# Auth: TOTP secret encryption at rest (AES-256-GCM). Required before
# /auth/register, /auth/register/confirm, or /auth/2fa/enroll will work —
# without it those routes fail loudly rather than ever writing a TOTP
# secret to the database in plaintext. Must decode to exactly 32 bytes.
# Generate one with:
#   openssl rand -base64 32
TOTP_ENC_KEY=

# Auth: git host credential (PAT) encryption at rest (AES-256-GCM). Required
# before git.credential_create or git.pipeline_status will work. Deliberately
# a separate key from TOTP_ENC_KEY (different secret class, independently
# rotatable). Must decode to exactly 32 bytes.
#   openssl rand -base64 32
GIT_CREDENTIAL_ENC_KEY=

# Auth: GitHub sign-in/account-linking (optional -- /auth/oauth/github/*
# routes fail loudly if unset when actually used). Create a GitHub OAuth
# App and set its Authorization callback URL to GITHUB_OAUTH_CALLBACK's
# value below (or, if left unset, this falls back to
# PROJECT_MEMORY_PUBLIC_URL + /auth/oauth/github/callback -- but that var
# already includes any /api prefix in some deployments, so setting this
# explicitly avoids getting that derivation wrong).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK=https://example.invalid/api/auth/oauth/github/callback

# Telegram bot (notifications mirror, optional -- absent TELEGRAM_BOT_TOKEN
# just means the feature doesn't run). Create a bot via @BotFather to get
# the token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
# Optional: routes the bot's outbound API calls through an HTTP CONNECT
# proxy (grammY's Node build uses node-fetch, so this must be a classic
# http.Agent-compatible proxy URL -- https-proxy-agent, not undici). The
# same proxy is also used for Telegram's OIDC endpoints below (oauth.telegram.org),
# via undici's ProxyAgent instead, since those go over native fetch.
TELEGRAM_BOT_PROXY=

# Login with Telegram (optional -- uses real OpenID Connect, NOT the old
# HMAC-signed Login Widget, which Telegram has fully retired). Get
# client_id/client_secret from @BotFather's own "Login Widget" panel
# (Bot Settings -> Login Widget) -- distinct credentials from the bot
# token above. TELEGRAM_OAUTH_CALLBACK must be registered there too.
TELEGRAM_OAUTH_CLIENT_ID=
TELEGRAM_OAUTH_SECRET=
TELEGRAM_OAUTH_CALLBACK=https://example.invalid/api/auth/oauth/telegram/callback

# Optional: the web app's own public origin (no /api suffix), used to build
# an "Open in Marrow" link in Telegram notifications. Falls back to
# PROJECT_MEMORY_PUBLIC_URL with any /api suffix stripped if unset.
MARROW_WEB_URL=

# Common
LOG_LEVEL=debug
LOG_DIR=./logs/
LOG_PRETTY=true
LOG_INCLUDE_TIME=true

