{
  "name": "@deadragdoll/marrow-back",
  "version": "1.38.0",
  "description": "Local-first MCP server for project-oriented agent memory.",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "pm3m": "dist/scripts/pm3m.js"
  },
  "files": [
    "dist/src",
    "dist/scripts",
    "deploy/nginx/project-memory-gateway.locations.conf",
    "deploy/nginx/project-memory-gateway.server.conf",
    "docs",
    "migrations",
    "ecosystem.config.cjs",
    "scripts/pm2-gateway.cjs",
    "knexfile.cjs",
    "README.md",
    "AGENTS.md"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "db:pg:migrate": "knex migrate:latest --knexfile knexfile.cjs",
    "db:pg:rollback": "knex migrate:rollback --knexfile knexfile.cjs",
    "db:pg:status": "knex migrate:status --knexfile knexfile.cjs",
    "dev": "tsx src/index.ts",
    "gateway": "node dist/src/gateway.js",
    "lint": "eslint .",
    "seed:common": "node dist/scripts/seed-common.js",
    "seed:templates": "node dist/scripts/seed-templates.js",
    "smoke": "node dist/scripts/smoke.js",
    "smoke:gateway": "node dist/scripts/smoke-gateway.js",
    "smoke:gateway:auth": "node dist/scripts/smoke-gateway-auth.js",
    "smoke:gateway:registration": "node dist/scripts/smoke-gateway-registration.js",
    "smoke:gateway:scopes": "node dist/scripts/smoke-gateway-scopes.js",
    "smoke:gateway:subscriptions": "node dist/scripts/smoke-gateway-subscriptions.js",
    "smoke:gateway:elevation": "node dist/scripts/smoke-gateway-elevation.js",
    "smoke:gateway:git-credentials": "node dist/scripts/smoke-gateway-git-credentials.js",
    "smoke:gateway:project-invites": "node dist/scripts/smoke-gateway-project-invites.js",
    "smoke:gateway:personal-tokens": "node dist/scripts/smoke-gateway-personal-tokens.js",
    "smoke:gateway:notifications": "node dist/scripts/smoke-gateway-notifications.js",
    "smoke:gateway:graphql": "node dist/scripts/smoke-gateway-graphql.js",
    "smoke:gateway:mcp-http": "node dist/scripts/smoke-gateway-mcp-http.js",
    "smoke:oauth": "node dist/scripts/smoke-oauth.js",
    "smoke:package": "node dist/scripts/smoke-package.js",
    "smoke:stdio": "node dist/scripts/smoke-stdio.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.codup.pro/prj/marrow.git",
    "directory": "backend"
  },
  "keywords": [
    "mcp",
    "memory",
    "sqlite"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://gitlab.codup.pro/prj/marrow/issues"
  },
  "homepage": "https://gitlab.codup.pro/prj/marrow/-/tree/main/backend#readme",
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@graphql-tools/schema": "^10.0.38",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "graphql": "^16.14.2",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.2.1",
    "knex": "^3.2.10",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "ws": "^8.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.3",
    "@types/ws": "^8.18.1",
    "eslint": "^10.5.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  }
}
