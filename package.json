{
  "name": "@deadragdoll/pm3m",
  "version": "1.6.0",
  "description": "Local-first MCP server for project-oriented agent memory.",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "pm3m": "dist/scripts/pm3m.js"
  },
  "files": [
    "dist/src",
    "dist/scripts",
    "deploy/nginx/project-memory-gateway.locations.conf",
    "deploy/nginx/project-memory-gateway.server.conf",
    "docs",
    "migrations",
    "ecosystem.config.cjs",
    "scripts/pm2-gateway.cjs",
    "knexfile.cjs",
    "README.md",
    "AGENTS.md"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "db:pg:migrate": "knex migrate:latest --knexfile knexfile.cjs",
    "db:pg:rollback": "knex migrate:rollback --knexfile knexfile.cjs",
    "db:pg:status": "knex migrate:status --knexfile knexfile.cjs",
    "dev": "tsx src/index.ts",
    "gateway": "node dist/src/gateway.js",
    "lint": "eslint .",
    "seed:common": "node dist/scripts/seed-common.js",
    "seed:templates": "node dist/scripts/seed-templates.js",
    "smoke": "node dist/scripts/smoke.js",
    "smoke:gateway": "node dist/scripts/smoke-gateway.js",
    "smoke:gateway:mcp-http": "node dist/scripts/smoke-gateway-mcp-http.js",
    "smoke:oauth": "node dist/scripts/smoke-oauth.js",
    "smoke:package": "node dist/scripts/smoke-package.js",
    "smoke:stdio": "node dist/scripts/smoke-stdio.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/prj/mcp/project_mem.git"
  },
  "keywords": [
    "mcp",
    "memory",
    "sqlite"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://gitlab.com/prj/mcp/project_mem/issues"
  },
  "homepage": "https://gitlab.com/prj/mcp/project_mem#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "knex": "^3.2.10",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.3",
    "eslint": "^10.5.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  }
}
