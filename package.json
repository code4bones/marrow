{
  "name": "project-memory-mcp",
  "version": "1.0.0",
  "description": "Local-first MCP server for project-oriented agent memory.",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "project-memory-mcp": "dist/src/index.js"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "lint": "eslint .",
    "seed:common": "tsx scripts/seed-common.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/prj/mcp/project_mem.git"
  },
  "keywords": [
    "mcp",
